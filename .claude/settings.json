{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; [ -n \"$CLAUDE_CODE_REMOTE\" ] && exit 0; command -v code-review-graph >/dev/null 2>&1 || exit 0; code-review-graph update --skip-flows --repo \"$CLAUDE_PROJECT_DIR\" || true",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash|WebFetch|WebSearch|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/model-router/router_nudge.py\" --repo",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; [ -n \"$CLAUDE_CODE_REMOTE\" ] && exit 0; command -v code-review-graph >/dev/null 2>&1 || exit 0; code-review-graph status --repo \"$CLAUDE_PROJECT_DIR\" || true",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/model-router/router_nudge.py\" --repo",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/model-router/router_nudge.py\" --repo",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
